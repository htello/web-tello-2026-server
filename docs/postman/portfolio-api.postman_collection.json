{
  "info": {
    "name": "Portfolio API - Antonio Tello",
    "description": "Colección completa de endpoints para la API del portfolio artístico.\n\n**Variables de entorno requeridas:**\n- `baseUrl`: http://localhost:3000/api/v1\n- `authToken`: Se llena automáticamente tras login\n\n**Flujo:**\n1. Ejecutar POST /Auth/Login para obtener token\n2. Los requests Admin usan el token automáticamente",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "  pm.environment.set('authToken', response.data.token);",
                  "  console.log('Token guardado en authToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "POST /admin/users/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo@test.com\",\n  \"password\": \"clave1234\",\n  \"name\": \"Nuevo Usuario\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", "register"]
            }
          }
        }
      ]
    },
