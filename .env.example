# Base de datos
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio_db

# Autenticación
JWT_SECRET=tu-clave-secreta-aqui-minimo-32-caracteres

# Frontend (base para enlaces de email, p. ej. recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

# Cloudinary (upload de imágenes)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Email — vía Resend (API HTTPS, obligatoria en Render free: bloquea SMTP 25/465/587)
# Si RESEND_API_KEY está definida, se usa Resend; si no, SMTP (desarrollo local)
RESEND_API_KEY=
# Remitente en Resend (sin dominio verificado solo permite enviar a tu propio email)
EMAIL_FROM=onboarding@resend.dev

# Email — vía SMTP (Nodemailer, fallback para desarrollo local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password

# Logging
LOG_LEVEL=info

# Sentry (opcional en desarrollo)
SENTRY_DSN=
# Release: definir en producción/CI (ej. SHA del commit). --env-file no expande $(...).
SENTRY_RELEASE=

# Puerto del servidor
PORT=3000
